# 复制为 .env 后按需修改
APP_NAME=duanju-v3
DEBUG=true

# JWT 签名密钥。留空时：开发模式(DEBUG=true)会自动生成一个临时密钥（重启后旧token失效）；
# 生产模式(DEBUG=false)会直接拒绝启动。正式部署前必须填一个随机值，例如：
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 默认用 SQLite 方便本地直接跑起来；上生产换成 MySQL/Postgres 连接串即可，
# 例如 mysql+aiomysql://user:pass@127.0.0.1:3306/duanju
DATABASE_URL=sqlite+aiosqlite:///./duanju.db

# 初始管理员账号。ADMIN_PASSWORD 留空时会在首次启动随机生成一个，打印在后端日志里，
# 只显示这一次——记得马上登录后台改掉，正式部署建议直接在这里填一个强密码。
ADMIN_PHONE=13800000000
ADMIN_PASSWORD=

# ---- 以下是预留的第三方服务配置位，未接入真实账号前均走 mock provider ----
# 支付（微信支付/支付宝），PAYMENT_PROVIDER=mock|wechat|alipay
PAYMENT_PROVIDER=mock
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# 短信，SMS_PROVIDER=mock|aliyun|tencent
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=

# 对象存储，STORAGE_PROVIDER=local|aliyun_oss|qiniu
STORAGE_PROVIDER=local
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
